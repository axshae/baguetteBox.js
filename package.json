{
    "name": "baguettebox.js",
    "version": "1.9.1",
    "author": "axshae",
    "description": "Simple and easy to use lightbox script written in pure JavaScript",
    "license": "MIT",
    "homepage": "https://github.com/axshae/baguetteBox.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/axshae/baguetteBox.js.git"
    },
    "bugs": {
        "url": "https://github.com/axshae/baguetteBox.js/issues"
    },
    "type": "module",
    "main": "dist/baguetteBox.min.js",
    "style": "dist/baguetteBox.min.css",
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "postinstall": "npm rebuild node-sass",
        "build": "rollup -c",
        "release": "standard-version && npm run build",
        "watch": "rollup -c -w",
        "gulp:start": "gulp",
        "gulp:lint": "gulp lint",
        "gulp:test": "gulp test",
        "gulp:release": "gulp release",
        "gulp:patch": "gulp patch",
        "gulp:build": "gulp build",
        "rollup:build": "rollup -c",
        "rollup:watch": "rollup -c -w",
        "demo:start": "npx nodemon --watch . --ext js,html,css --exec \"npx http-server demo/\""
    },
    "resolutions": {
        "natives": "1.1.3"
    },
    "devDependencies": {
        "@rollup/plugin-replace": "~6.0.2",
        "@rollup/plugin-terser": "~0.4.4",
        "browser-sync": "^3.0.3",
        "gulp": "^5.0.0",
        "gulp-autoprefixer": "^9.0.0",
        "gulp-bump": "^3.2.0",
        "gulp-concat": "^2.6.1",
        "gulp-cssmin": "~0.2.0",
        "gulp-eslint": "^6.0.0",
        "gulp-gh-pages": "~0.5.4",
        "gulp-if": "^3.0.0",
        "gulp-inject-version": "^1.0.1",
        "gulp-load-plugins": "^2.0.8",
        "gulp-rimraf": "~1.0.0",
        "gulp-sass": "~6.0.0",
        "gulp-uglify": "^3.0.2",
        "gulp-usemin": "~0.3.30",
        "jsonfile": "^6.1.0",
        "rollup": "~4.32.0",
        "rollup-plugin-scss": "~4.0.1",
        "run-sequence": "^2.2.1",
        "standard-version": "~9.5.0"
    },
    "overrides": {
        "graceful-fs": "^4.2.11",
        "gift": "0.10.2"
    },
    "keywords": [
        "lightbox",
        "gallery",
        "modal",
        "responsive"
    ],
    "dependencies": {
        "sass": "~1.83.4"
    }
}
